<p>
  <label for="settings_teams_url"><%= l(:label_settings_teams_url) %></label>
  <%= text_field_tag 'settings[teams_url]', settings['teams_url'], size: 80 %>
</p>
<p><%= l(:helper_settings_temas_url_webhook).html_safe %></p>

<p>
  <label for="settings_display_watchers"><%= l(:label_settings_display_watchers) %></label>
  <%= select_tag 'settings[display_watchers]',
                 options_for_select([[l(:label_option_yes), 'yes'], [l(:label_option_no), 'no']],
                                    settings['display_watchers'] == 'yes' ? 'yes' : 'no') %>
</p>

<p>
  <label for="settings_post_updates"><%= l(:label_settings_post_issue_updates) %></label>
  <%= check_box_tag 'settings[post_updates]', '1', settings['post_updates'] == '1' %>
</p>
<p>
  <label for="settings_webhook_role"><%= l(:label_role) %></label>
  <%= text_field_tag 'settings[webhook_role]', settings['webhook_role'] %>
</p>

<p>
  <label for="settings_post_wiki_updates"><%= l(:label_settings_post_wiki_updates) %></label>
  <%= check_box_tag 'settings[post_wiki_updates]', '1', settings['post_wiki_updates'] == '1' %>
</p>
